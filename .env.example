# Copy this file to .env and fill in your own keys. Never commit .env.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI: dashboard > AI > Workers AI > REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle: Settings > API > Generate New Token. Copy the token it shows (it is shown once).
# The username is the name in your profile address: kaggle.com/<username>
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Optional. Only used for the measured comparison of script drafts.
ANTHROPIC_API_KEY=

# Optional: Amharic narration from Addis AI (paid; https://addisassistant.com)
ADDIS_API_KEY=

# Optional: deploying the board to a Hugging Face Space (deploy/README.md)
HF_TOKEN=
